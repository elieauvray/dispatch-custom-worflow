# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optional: whsec_... secret of the webhook configured in the Claude Console
ANTHROPIC_WEBHOOK_SECRET=

# --- Local only (on Upsun, these values are derived automatically) ---
# URL printed by `upsun tunnel:single --relationship database`, or a local PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/dispatch
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8000
