# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optionnel : secret whsec_... du webhook configuré dans la Claude Console
ANTHROPIC_WEBHOOK_SECRET=

# --- Local uniquement (sur Upsun, ces valeurs sont déduites automatiquement) ---
# URL affichée par `upsun tunnel:single --relationship database`, ou un PostgreSQL local
DATABASE_URL=postgresql://user:pass@localhost:5432/dispatch
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8000
